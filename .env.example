# Public alias generated by Web3Forms. It is safe to include in a static build.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=replace_with_web3forms_access_key

# Paste the action URL from the HTML version of your Brevo signup form.
NEXT_PUBLIC_BREVO_FORM_ACTION=https://example.sibforms.com/serve/replace_me

# Google Analytics 4 Measurement ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Leave empty for a custom domain. Use /repository-name for a GitHub project page.
PAGES_BASE_PATH=
